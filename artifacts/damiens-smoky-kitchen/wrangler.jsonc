{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "damien-smoky-kitchen-chatbot54",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-09-24",
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 },
    "issues": { "enabled": true }
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "damien-smoky-kitchen-orders",
      "database_id": "1db6849c-2db7-476d-9f73-7b7bde7b81fd",
      "migrations_dir": "migrations"
    }
  ],

  "ratelimits": [
    {
      "name": "CHAT_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 }
    }
  ],

  "ai": {
    "binding": "AI"
  },

  "previews": {
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "damien-smoky-kitchen-orders-preview",
        "database_id": "106a3a8d-f4eb-4151-aac5-34ca245982e6"
      }
    ],
    "ratelimits": [
      {
        "name": "CHAT_RATE_LIMIT",
        "namespace_id": "1002",
        "simple": { "limit": 20, "period": 60 }
      }
    ],
    "ai": { "binding": "AI" },
    "observability": {
      "enabled": true,
      "logs": { "enabled": true, "head_sampling_rate": 1 },
      "traces": { "enabled": true, "head_sampling_rate": 0.1 }
    }
  },

  "assets": {
    "directory": "./dist/public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  }
}
