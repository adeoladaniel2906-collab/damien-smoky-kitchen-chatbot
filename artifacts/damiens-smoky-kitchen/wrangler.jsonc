{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "damien-smoky-kitchen-chatbot",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-23",

  "ai": {
    "binding": "AI"
  },

  "assets": {
    "directory": "./dist/public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  }
}
