{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "damien-smoky-kitchen-chatbot54",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-09-24",
  "vars": {
    "ORDERS_ENABLED": "false",
    "CUSTOMER_AUTH_ENABLED": "true",
    "STAFF_AUTH_ENABLED": "true",
    "CLERK_PUBLISHABLE_KEY": "pk_test_d2lyZWQtbW9uaXRvci0zNDY0LmNsZXJrLmFjY291bnRzLmRldiQ"
  },
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.1,
      "invocation_logs": false,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05,
      "persist": false
    },
    "issues": {
      "enabled": true
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "damien-smoky-kitchen-orders-eu",
      "database_id": "d8ab1f47-bb9a-4f45-a017-848397fc4c4f",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "CHAT_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": {
        "limit": 20,
        "period": 60
      }
    },
    {
      "name": "ORDER_RATE_LIMIT",
      "namespace_id": "1003",
      "simple": {
        "limit": 5,
        "period": 60
      }
    },
    {
      "name": "AUTH_RATE_LIMIT",
      "namespace_id": "1005",
      "simple": {
        "limit": 8,
        "period": 60
      }
    },
    {
      "name": "AUTH_EMAIL_RATE_LIMIT",
      "namespace_id": "1007",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "previews": {
    "vars": {
      "ORDERS_ENABLED": "false",
      "CUSTOMER_AUTH_ENABLED": "true",
      "STAFF_AUTH_ENABLED": "true",
      "CLERK_PUBLISHABLE_KEY": "pk_test_d2lyZWQtbW9uaXRvci0zNDY0LmNsZXJrLmFjY291bnRzLmRldiQ"
    },
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "damien-smoky-kitchen-orders-preview-eu",
        "database_id": "06ff960d-aeaa-41da-9fd6-51b2b59274be"
      }
    ],
    "ratelimits": [
      {
        "name": "CHAT_RATE_LIMIT",
        "namespace_id": "1002",
        "simple": {
          "limit": 20,
          "period": 60
        }
      },
      {
        "name": "ORDER_RATE_LIMIT",
        "namespace_id": "1004",
        "simple": {
          "limit": 5,
          "period": 60
        }
      },
      {
        "name": "AUTH_RATE_LIMIT",
        "namespace_id": "1006",
        "simple": {
          "limit": 8,
          "period": 60
        }
      },
      {
        "name": "AUTH_EMAIL_RATE_LIMIT",
        "namespace_id": "1008",
        "simple": {
          "limit": 5,
          "period": 60
        }
      }
    ],
    "ai": {
      "binding": "AI"
    },
    "observability": {
      "enabled": true,
      "redact_query_string": true,
      "logs": {
        "enabled": true,
        "head_sampling_rate": 0.1,
        "invocation_logs": false,
        "persist": true
      },
      "traces": {
        "enabled": true,
        "head_sampling_rate": 0.05,
        "persist": false
      }
    }
  },
  "assets": {
    "directory": "./dist/public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  }
}
